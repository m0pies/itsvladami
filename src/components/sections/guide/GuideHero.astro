---
import type { Guide } from "../../../data/guides";
import Button from "../../Button.astro";
import Container from "../../layout/Container.astro";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;

const eyebrowClasses = {
  fashion: "bg-guide-fashion",
  travel: "bg-guide-travel",
};
---

<section class="h-[100svh] min-h-[36rem] max-h-[43.75rem] overflow-clip" aria-labelledby="guide-title" data-guide-hero>
  <Container class="flex h-full flex-col justify-between gap-8 pt-[4.75rem] pb-4 md:pt-[6.75rem] md:pb-12">
    <div class="flex items-start justify-center text-center">
      <div class="flex max-w-3xl flex-col items-center">
        <!-- <p
          class:list={[
            "mb-3 rounded-lg px-2 py-1 text-xs leading-none font-medium",
            eyebrowClasses[guide.accent],
          ]}
          data-site-reveal
        >
          {guide.eyebrow}
        </p> -->
        <h1 id="guide-title" class="text-hero text-balance" data-site-reveal>{guide.title}</h1>
        <p class="mt-3 max-w-xl text-small text-balance text-muted" data-site-reveal>
          {guide.description}
        </p>
        <div class="mt-4" data-site-reveal>
          <Button
            variant="primary"
            size="sm"
            href={guide.purchaseUrl ?? undefined}
            disabled={!guide.purchaseUrl}
            ariaLabel={`Купить «${guide.title}» за ${guide.price}`}
          >
            Купить за {guide.price}
          </Button>
        </div>
      </div>
    </div>

    <div class="guide-stack relative mx-auto w-full max-w-md" data-site-reveal>
      <img
        class="guide-side guide-side-left absolute top-[5%] -left-[3%] z-0 h-auto w-[65%] max-w-64 rounded-md border border-border shadow-lg sm:-left-[42%] sm:w-[68%] lg:-left-[30%] lg:w-[57%]"
        src={guide.sideImages.left}
        alt=""
        width="960"
        height="1280"
        loading="eager"
        aria-hidden="true"
      />
      <img
        class="relative z-10 mx-auto block h-auto w-[76%] max-w-72 rounded-lg border border-border shadow-md sm:w-[80%] lg:w-[68%]"
        src={guide.cover}
        alt={`Обложка PDF-гайда «${guide.title}»`}
        width="960"
        height="1280"
        loading="eager"
        fetchpriority="high"
      />
      <img
        class="guide-side guide-side-right absolute top-[5%] -right-[3%] z-0 h-auto w-[65%] max-w-64 rounded-md border border-border shadow-lg sm:-right-[42%] sm:w-[68%] lg:-right-[30%] lg:w-[57%]"
        src={guide.sideImages.right}
        alt=""
        width="960"
        height="1280"
        loading="eager"
        aria-hidden="true"
      />
    </div>
  </Container>
</section>

<script>
  const guideStacks = document.querySelectorAll<HTMLElement>(".guide-stack");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );

    guideStacks.forEach((stack) => observer.observe(stack));
  } else {
    guideStacks.forEach((stack) => stack.classList.add("is-visible"));
  }
</script>
