---
import type { Guide } from "../../../data/guides";
import Section from "../../layout/Section.astro";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
---

<Section
  id="preview"
  labelledby="guide-preview-title"
  class="overflow-x-clip"
  containerClass="max-w-5xl"
>
  <div class="text-center">
    <h2 id="guide-preview-title" class="text-h2" data-site-reveal>
      Загляни внутрь
    </h2>
    <p class="mx-auto mt-3 max-w-md text-small text-balance text-muted" data-site-reveal>
      Листай прямо в телефоне – так гайд будет выглядеть у тебя после покупки.
    </p>
  </div>

  <div class="mt-8 flex justify-center md:mt-12">
    <div
      class="relative w-full max-w-56 drop-shadow-xl sm:max-w-60"
      data-guide-phone
    >
      <div class="aspect-[1406/2822]" aria-hidden="true"></div>

      <div
        class="absolute top-[3.544%] left-[5.334%] flex h-[92.9%] w-[89.332%] flex-col overflow-hidden rounded-[8%] bg-white"
      >
        <img
          class="relative z-1 block h-auto w-full shrink-0"
          src="/images/iphone/ios-status-bar.webp"
          alt=""
          width="393"
          height="54"
          loading="eager"
          aria-hidden="true"
        />

        <div class="relative min-h-0 w-full flex-1">
          <div
            class="flex size-full flex-col gap-1 bg-accent-soft touch-pan-y overflow-y-auto overscroll-y-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            data-guide-preview-scroll
            role="region"
            tabindex="0"
            aria-label={`Страницы гайда «${guide.title}». Прокручиваемая область.`}
          >
            {guide.previewPages.map((page, index) => (
              <img
                class="block h-auto w-full"
                src={page.image}
                alt={page.alt}
                width="960"
                height="1280"
                loading={index === 0 ? "eager" : "lazy"}
              />
            ))}
          </div>

          <img
            class="pointer-events-none absolute inset-x-0 bottom-0 z-1 block h-auto w-full select-none"
            src="/images/iphone/ios-tab-bar.webp"
            alt=""
            width="402"
            height="109"
            loading="eager"
            draggable="false"
            aria-hidden="true"
          />
        </div>
      </div>

      <img
        class="pointer-events-none absolute inset-0 z-10 size-full select-none"
        src="/images/iphone-16-pro-frame.png"
        alt=""
        width="1406"
        height="2822"
        loading="lazy"
        draggable="false"
        aria-hidden="true"
      />
    </div>
  </div>
</Section>

<script>
  document.querySelectorAll<HTMLElement>("[data-guide-preview-scroll]").forEach((preview) => {
    preview.addEventListener(
      "wheel",
      (event) => {
        const isAtStart = preview.scrollTop <= 0;
        const isAtEnd = preview.scrollTop + preview.clientHeight >= preview.scrollHeight - 1;
        const isLeavingPreview = (event.deltaY < 0 && isAtStart) || (event.deltaY > 0 && isAtEnd);

        if (isLeavingPreview) return;

        const deltaMultiplier = event.deltaMode === 1
          ? 16
          : event.deltaMode === 2
            ? preview.clientHeight
            : 1;

        event.preventDefault();
        preview.scrollTop += event.deltaY * deltaMultiplier;
      },
      { passive: false },
    );
  });
</script>
