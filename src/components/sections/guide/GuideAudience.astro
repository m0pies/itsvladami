---
import type { Guide } from "../../../data/guides";
import Section from "../../layout/Section.astro";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const audiences = guide.audiences;
---

<Section id="audience" labelledby="guide-audience-title">
  <div data-guide-audience>
    <h2 id="guide-audience-title" class="text-center text-h2" data-site-reveal>
      Кому подойдёт гайд
    </h2>

    <div
      class="relative mx-auto mt-8 max-w-2xl md:mt-12"
      data-audience-carousel
      data-site-reveal
      aria-roledescription="карусель"
      aria-label={`Для кого подойдёт гайд «${guide.title}»`}
    >
      <div class="mx-auto max-w-md px-12 text-center sm:px-14">
        <div class="relative mx-auto aspect-3/4 w-full max-w-xs overflow-hidden">
          <div class="absolute inset-1">
            {audiences.map((audience, index) => (
              <img
                class:list={[
                  "absolute inset-0 size-full object-contain",
                  index !== 0 && "hidden",
                ]}
                src={audience.image}
                alt={audience.imageAlt}
                width="900"
                height="1200"
                loading="eager"
                data-audience-image
                data-audience-index={index}
                aria-hidden={index === 0 ? "false" : "true"}
              />
            ))}
          </div>
        </div>

        <div class="mt-8" aria-live="polite">
          {audiences.map((audience, index) => (
            <article
              class:list={["flex flex-col items-center", index !== 0 && "hidden"]}
              data-audience-copy
              data-audience-index={index}
              aria-hidden={index === 0 ? "false" : "true"}
              aria-roledescription="слайд"
              aria-label={`${index + 1} из ${audiences.length}`}
            >
              <p class="mx-auto max-w-xs text-small text-balance text-muted">
                <span class="text-stone-800">{audience.title}.</span> {audience.description}
              </p>
            </article>
          ))}
        </div>
      </div>

      <button
        type="button"
        class="absolute top-1/2 left-0 z-10 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-border bg-accent-soft text-foreground transition-colors duration-200 hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 motion-reduce:transition-none sm:size-12"
        data-audience-step="prev"
        aria-label="Предыдущая карточка"
      >
        <span class="block size-2.5 translate-x-0.5 -rotate-135 border-t-2 border-r-2" aria-hidden="true"></span>
      </button>

      <button
        type="button"
        class="absolute top-1/2 right-0 z-10 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-border bg-accent-soft text-foreground transition-colors duration-200 hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 motion-reduce:transition-none sm:size-12"
        data-audience-step="next"
        aria-label="Следующая карточка"
      >
        <span class="block size-2.5 -translate-x-0.5 rotate-45 border-t-2 border-r-2" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</Section>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-audience-carousel]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  carousels.forEach((carousel) => {
    const images = Array.from(carousel.querySelectorAll<HTMLImageElement>("[data-audience-image]"));
    const copies = Array.from(carousel.querySelectorAll<HTMLElement>("[data-audience-copy]"));
    let activeIndex = images.findIndex((image) => image.getAttribute("aria-hidden") === "false");
    let transitionId = 0;
    let activeAnimations: Animation[] = [];
    let pointerStartX: number | null = null;

    if (activeIndex < 0) activeIndex = 0;

    const cancelActiveAnimations = () => {
      activeAnimations.forEach((animation) => animation.cancel());
      activeAnimations = [];
    };

    const settleImages = () => {
      images.forEach((image, index) => {
        const isActive = index === activeIndex;
        image.classList.toggle("hidden", !isActive);
        image.setAttribute("aria-hidden", String(!isActive));
      });
    };

    const showSlide = (direction: number) => {
      if (images.length < 2) return;

      transitionId += 1;
      const currentTransitionId = transitionId;
      cancelActiveAnimations();
      settleImages();

      const previousIndex = activeIndex;
      activeIndex = (activeIndex + direction + images.length) % images.length;
      const previousImage = images[previousIndex];
      const activeImage = images[activeIndex];

      copies.forEach((copy, index) => {
        const isActive = index === activeIndex;
        copy.classList.toggle("hidden", !isActive);
        copy.setAttribute("aria-hidden", String(!isActive));
      });

      if (!previousImage || !activeImage) return;

      previousImage.classList.remove("hidden");
      previousImage.setAttribute("aria-hidden", "true");
      activeImage.classList.remove("hidden");
      activeImage.setAttribute("aria-hidden", "false");

      if (reducedMotion.matches) {
        settleImages();
        return;
      }

      const outgoingAnimation = previousImage.animate(
        [
          {
            opacity: 1,
            filter: "blur(0)",
            transform: "translate3d(0, 0, 0) scale(1)",
          },
          {
            opacity: 0,
            filter: "blur(0.5rem)",
            transform: `translate3d(${direction > 0 ? "-0.75rem" : "0.75rem"}, 0, 0) scale(0.96)`,
          },
        ],
        {
          duration: 480,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "both",
        },
      );

      const incomingAnimation = activeImage.animate(
        [
          {
            opacity: 0,
            filter: "blur(0.625rem)",
            transform: `translate3d(${direction > 0 ? "0.75rem" : "-0.75rem"}, 0, 0) scale(1.025)`,
          },
          {
            opacity: 1,
            filter: "blur(0)",
            transform: "translate3d(0, 0, 0) scale(1)",
          },
        ],
        {
          duration: 560,
          easing: "cubic-bezier(0.22, 1, 0.36, 1)",
          fill: "both",
        },
      );

      activeAnimations = [outgoingAnimation, incomingAnimation];

      void Promise.allSettled(activeAnimations.map((animation) => animation.finished)).then(() => {
        if (currentTransitionId !== transitionId) return;

        settleImages();
        cancelActiveAnimations();
      });
    };

    carousel.querySelectorAll<HTMLButtonElement>("[data-audience-step]").forEach((button) => {
      button.addEventListener("click", () => {
        showSlide(button.dataset.audienceStep === "prev" ? -1 : 1);
      });
    });

    carousel.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      showSlide(event.key === "ArrowLeft" ? -1 : 1);
    });

    carousel.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      pointerStartX = event.clientX;
    });

    carousel.addEventListener("pointerup", (event) => {
      if (pointerStartX === null) return;

      const distance = event.clientX - pointerStartX;
      pointerStartX = null;

      if (Math.abs(distance) >= 48) showSlide(distance < 0 ? 1 : -1);
    });

    carousel.addEventListener("pointercancel", () => {
      pointerStartX = null;
    });
  });
</script>
