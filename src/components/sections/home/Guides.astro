---
import Button from "../../Button.astro";
import Section from "../../layout/Section.astro";

const guides = [
  {
    title: "Фэшн чайниз",
    description: "Китайский язык через стиль, тренды и слова, которые встречаются вокруг.",
    price: "2 990 ₽",
    cover: "/images/fc-cover.webp",
    sideImages: {
      left: "/images/fc-content.webp",
      right: "/images/fc-page.webp",
    },
    purchaseUrl: null,
    detailsUrl: null,
  },
  {
    title: "В Китай без китайского",
    description: "Фразы для первых дней в Китае: от аэропорта и такси до заказа еды.",
    price: "990 ₽",
    cover: "/images/vkbk-cover.webp",
    sideImages: {
      left: "/images/vkbk-content.webp",
      right: "/images/vkbk-page.webp",
    },
    purchaseUrl: null,
    detailsUrl: null,
  },
];
---

<Section id="guides" labelledby="guides-title">
  <div class="flex flex-col items-center gap-3" data-site-reveal>
    <h2 id="guides-title" class="text-center text-h2">С чего начнём?</h2>
    <p class="max-w-xl text-center text-small text-balance text-muted">Выберите гайд о китайском языке, который тебе подходит.</p>
  </div>

  <div class="mt-8 space-y-16 md:space-y-32">
    {guides.map((guide) => (
      <article class="flex flex-col items-center overflow-clip text-center">
        <div class="guide-stack grid w-full max-w-md grid-cols-3 items-center" data-site-reveal>
          <img
            class="guide-side guide-side-left relative z-0 col-start-1 row-start-1 -mr-12 aspect-3/4 w-38 max-w-none justify-self-end rounded-lg border border-border object-cover shadow-lg"
            src={guide.sideImages.left}
            alt={`Оглавление PDF-гайда «${guide.title}»`}
            width="960"
            height="1280"
            loading="lazy"
            aria-hidden="true"
          />
          <img
            class="relative z-10 col-start-2 row-start-1 aspect-3/4 w-44 max-w-none justify-self-center rounded-lg border border-border object-cover shadow-lg"
            src={guide.cover}
            alt={`Обложка PDF-гайда «${guide.title}»`}
            width="960"
            height="1280"
            loading="lazy"
          />
          <img
            class="guide-side guide-side-right relative z-0 col-start-3 row-start-1 -ml-12 aspect-3/4 w-38 max-w-none justify-self-start rounded-lg border border-border object-cover shadow-lg"
            src={guide.sideImages.right}
            alt={`Страница PDF-гайда «${guide.title}»`}
            width="960"
            height="1280"
            loading="lazy"
            aria-hidden="true"
          />
        </div>

        <div class="flex max-w-xl flex-col items-center px-4 pt-8" data-site-reveal>
          <h3 class="text-h3">{guide.title}</h3>
          <p class="mt-2 max-w-lg text-small text-balance text-muted">{guide.description}</p>
          <div class="mt-4 flex flex-wrap justify-center gap-2">
            <Button
              variant="primary"
              size="sm"
              href={guide.purchaseUrl ?? undefined}
              disabled={!guide.purchaseUrl}
              ariaLabel={`Купить «${guide.title}» за ${guide.price}`}
            >
              {guide.price}
            </Button>
            <Button
              variant="secondary"
              size="sm"
              href={guide.detailsUrl ?? undefined}
              disabled={!guide.detailsUrl}
              ariaLabel={`Подробнее о гайде «${guide.title}»`}
            >
              Подробнее
            </Button>
          </div>
        </div>
      </article>
    ))}
  </div>
</Section>

<script>
  const guideStacks = document.querySelectorAll<HTMLElement>(".guide-stack");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );

    guideStacks.forEach((stack) => observer.observe(stack));
  } else {
    guideStacks.forEach((stack) => stack.classList.add("is-visible"));
  }
</script>
