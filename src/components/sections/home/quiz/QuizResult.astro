---
import Button from "../../../Button.astro";
import QuizGuideBanner from "./QuizGuideBanner.astro";
import { cityResults, quizGuides } from "./quiz-data";
import type { GuideId } from "./quiz-data";
---

<div data-quiz-screen="result" class="mx-auto hidden max-w-3xl">
  <p data-quiz-enter class="inline-flex rounded-lg bg-accent-soft px-2 py-1 text-xs leading-none font-medium sm:text-sm">
    Результат
  </p>
  <h2 data-quiz-heading data-quiz-result-title data-quiz-enter tabindex="-1" class="mt-4 text-h2 text-balance outline-none">
    Твой город
  </h2>
  <p data-quiz-result-note data-quiz-enter class="mt-3 hidden max-w-2xl text-small text-muted"></p>

  <div class="mt-4" data-quiz-result-list>
    {Object.entries(cityResults).map(([cityId, result]) => (
      <article
        class="hidden"
        data-quiz-city-result={cityId}
        data-city-name={result.name}
        data-city-emoji={result.emoji}
        data-guide-id={result.guideId}
      >
        <div data-quiz-result-image data-quiz-enter class="relative">
          <img
            src={result.image}
            alt={`Панорама города ${result.name}`}
            width="1200"
            height="630"
            loading="lazy"
            class="h-52 w-full rounded-2xl object-cover"
          />
        </div>
        <p data-quiz-enter class="mt-8 mx-auto text-center max-w-xs text-small text-muted">{result.description}</p>
      </article>
    ))}
  </div>

  <div class="mt-8" data-quiz-guide-list>
    {Object.entries(quizGuides).map(([guideId, guide]) => (
      <QuizGuideBanner guideId={guideId as GuideId} guide={guide} />
    ))}
  </div>

  <div
    data-quiz-restart-control
    class="pointer-events-none absolute inset-0 hidden items-center justify-center opacity-0 transition-opacity duration-700 ease-out motion-reduce:transition-none"
  >
    <Button
      data-quiz-restart
      type="button"
      size="sm"
      variant="glass"
      overlay
      ariaLabel="Пройти тест ещё раз"
    >
      Пройти ещё раз
    </Button>
  </div>
</div>
