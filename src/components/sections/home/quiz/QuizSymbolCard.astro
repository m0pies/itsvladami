---
import type { QuizVisual } from "./quiz-data";

interface Props {
  visual: QuizVisual;
}

const { visual } = Astro.props;
---

<figure
  data-quiz-enter
  class:list={[
    "mt-4 flex h-44 w-full flex-col items-center justify-center overflow-hidden rounded-2xl bg-accent-soft text-center",
    !visual.image && "px-6 py-5",
  ]}
>
  {visual.image ? (
    <img
      src={visual.image}
      alt={visual.alt ?? ""}
      width="1200"
      height="630"
      loading="lazy"
      class="h-full w-full object-cover"
    />
  ) : (
    <>
      {visual.pinyin && <p class="text-small text-muted">{visual.pinyin}</p>}
      <div
        lang={visual.lang}
        class:list={[
          "text-symbol",
          visual.pinyin && "mt-2",
          visual.lang === "zh" ? "font-cjk" : "font-sans",
        ]}
      >
        {visual.symbol}
      </div>
      {visual.translation && <figcaption class="mt-2 text-small text-muted">{visual.translation}</figcaption>}
    </>
  )}
</figure>
