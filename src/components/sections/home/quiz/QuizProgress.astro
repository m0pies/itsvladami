---
interface Props {
  index: number;
  total: number;
}

const { index, total } = Astro.props;
const progress = total > 1 ? (index / (total - 1)) * 100 : 0;
---

<div
  data-quiz-progress
  data-quiz-enter
  data-progress-target={progress}
  class="mt-4 w-full px-2 pt-6 sm:px-3"
  aria-label={`Шаг ${index + 1} из ${total}`}
>
  <div class="relative h-px bg-border">
    <div
      data-quiz-progress-fill
      class="absolute inset-y-0 left-0 bg-accent transition-[width] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none"
      style={`width: ${progress}%`}
    ></div>
    <div
      data-quiz-progress-marker
      class="absolute top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center transition-[left] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none"
      style={`left: ${progress}%`}
    >
      <span class="absolute bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap text-xs text-muted">
        {index + 1} / {total}
      </span>
      <span class="size-3 rounded-full bg-accent" aria-hidden="true"></span>
    </div>
  </div>
</div>
