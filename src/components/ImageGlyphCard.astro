---
interface Props {
  src: string;
  alt: string;
  glyph: string;
  class?: string;
  style?: string;
  loading?: "eager" | "lazy";
}

const {
  src,
  alt,
  glyph,
  class: className,
  style,
  loading = "lazy",
} = Astro.props;
---

<div
  class:list={[
    "flex flex-col overflow-hidden rounded-2xl border border-border bg-background p-1 shadow-lg shadow-foreground/5",
    className,
  ]}
  style={style}
>
  <div class="aspect-square w-full p-0.5 overflow-hidden rounded-xl">
    <img class="rounded-lg h-full w-full object-cover" src={src} alt={alt} width="960" height="960" loading={loading} decoding="async" />
  </div>
  <div class="flex h-fit my-1 shrink-0 items-center justify-center" aria-hidden="true">
    <span class="font-cjk text-sm leading-none text-accent">{glyph}</span>
  </div>
</div>
