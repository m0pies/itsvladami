---
interface Props {
  [key: string]: unknown;
  variant?: "primary" | "secondary" | "tertiary" | "glass";
  size?: "lg" | "md" | "sm";
  href?: string;
  disabled?: boolean;
  fullWidth?: boolean;
  overlay?: boolean;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  disabled = false,
  fullWidth = false,
  overlay = false,
  type = "button",
  ariaLabel,
  ...rest
} = Astro.props;

const baseClasses = "inline-flex items-center justify-center text-center font-regular whitespace-nowrap transition-colors duration-300 motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 disabled:cursor-not-allowed";

const variantClasses = {
  primary: "bg-accent text-white hover:bg-accent-hover",
  secondary: "border border-border bg-accent-soft text-foreground hover:border-accent hover:bg-accent-soft disabled:hover:border-border disabled:hover:bg-background",
  tertiary: "rounded-none bg-transparent px-0 text-foreground hover:text-accent-hover",
  glass: "border border-white/10 bg-white/10 text-white backdrop-blur-md hover:bg-black/40 group-hover:bg-black/40",
};

const sizeClasses = {
  lg: "text-xl px-5 py-3 rounded-xl",
  md: "text-lg px-4 py-2.5 rounded-xl",
  sm: "min-w-19 text-sm px-3 py-1.5 rounded-lg",
}

const classes = [baseClasses, variantClasses[variant], sizeClasses[size], fullWidth && "w-full"];
const overlayClasses = "group absolute inset-0 flex h-full w-full cursor-pointer items-center justify-center rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 disabled:cursor-not-allowed";
const overlayLabelClasses = [baseClasses, variantClasses[variant], sizeClasses[size]];
---

{
  overlay && href && !disabled ? (
    <a {...rest} class={overlayClasses} href={href} aria-label={ariaLabel}>
      <span class:list={overlayLabelClasses}><slot /></span>
    </a>
  ) : overlay ? (
    <button {...rest} class={overlayClasses} type={type} disabled={disabled} aria-label={ariaLabel}>
      <span class:list={overlayLabelClasses}><slot /></span>
    </button>
  ) : href && !disabled ? (
    <a {...rest} class:list={classes} href={href} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button {...rest} class:list={classes} type={type} disabled={disabled} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}

