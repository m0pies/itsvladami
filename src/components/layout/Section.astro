---
import Container from "./Container.astro";

interface Props {
  id?: string;
  labelledby?: string;
  class?: string;
  containerClass?: string;
}

const {
  id,
  labelledby,
  class: className,
  containerClass,
} = Astro.props;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={["py-12 md:py-16", className]}
>
  <Container class={containerClass}>
    <slot />
  </Container>
</section>
